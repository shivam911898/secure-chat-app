    "testEnvironment": "node",
    "testTimeout": 20000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/shivam911898/secure-chat-app"
  },
  "keywords": [],
